# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# 联调自建聚合服务端（CatVod / TVBox）时，它会在工作目录写出自己的配置文件；
# 那是运行残留，不是本项目的东西。
/wexfnwconfig.json

# 构建产物：未签名 IPA 从 Actions 下载后放在仓库根目录取用，
# 体积 18MB 且可随时重新下载，不入版本库。
*.ipa

# 整体升级/预览导出的静态站点（生成物，本地查看用）
/sites/

# Widget Preview related
.widget_preview/

# 本机下载、预览与原生编译缓存，不随源码发布。
/.cache/
/LumeBox-unsigned-ipa/
/TTS超分辨依赖包/
**/.cxx/

# 源脚本的本地缓存（脚本在独立仓库 teng662858/LumeBox-Sources，
# 用 `dart run tool/fetch_sources.dart` 拉一份；原生用例读它）
.sources-cache/

# Downloaded CPython runtime and hash-locked wheels
ios/PythonRuntime/

# 侦察/跑测临时产物（tools/lume-probe.mjs 会往这里写页面快照）
.tmp_probe/

# 本地截图、页面快照与诊断输出；已跟踪的参考图保持不变。
/.tmp_shots/

# Deterministically prepared offline runtime assets; upstream inputs stay tracked.
/assets/models/intro/mobileclip_s0_image.zip
/assets/models/intro/compact_checksums.json
/assets/speech/vits_aishell3/runtime/*
!/assets/speech/vits_aishell3/runtime/.gitkeep
